# Variables BD DMySQL

MYSQL_ROOT_PASSWORD=***
MYSQL_DATABASE=***
MYSQL_USER=***
MYSQL_PASSWORD=***
DB_PORT=3301
ADMINER_PORT=8080
API_PORT=8081
CLIENT_PORT=8501

# les logs sont stockés en base, purge après J jours,
# pas de purge si LOG_RETENTION_DAYS=0 ou absent

LOG_RETENTION_DAYS=10 

# Observability Langfuse

LANGFUSE_ENABLED=true

# Clés du projet Langfuse (Project Settings -> API Keys)
LANGFUSE_SECRET_KEY=sk-lf-***
LANGFUSE_PUBLIC_KEY=pk-lf-***
LANGFUSE_BASE_URL=https://langfuse.example

# Métadonnées d'exécution
LANGFUSE_ENV=prod | dev | test
LANGFUSE_SERVICE_NAME=***
LANGFUSE_RELEASE=***

# Comportement SDK
LANGFUSE_SAMPLE_RATE=1.0 # 1.0 = 100% des traces envoyées...
LANGFUSE_TIMEOUT_SECONDS=**
LANGFUSE_FLUSH_AT=**
LANGFUSE_FLUSH_INTERVAL_MS=**

